# Production settings for compose.prod.yml. Copy to .env.prod (never commit it) and fill in:
#   docker compose -f compose.prod.yml --env-file .env.prod up -d --build --wait
# Generate secrets with:  openssl rand -base64 32

# Domain pointing at this server (A/AAAA record). Caddy gets the HTTPS certificate for it.
DOMAIN=autopoint.example.kz

# Database owner (runs migrations) and the restricted role the app uses.
POSTGRES_USER=autopoint
POSTGRES_DB=autopoint
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Signs booking links and staff login tokens. Changing it logs everyone out.
SECRET_KEY=

# true = load the demo catalogue, prices, team and gallery into an empty database.
# No demo staff logins are created in production; create the owner with app.manage.
SEED_DEMO=false

# Telegram staff notifications (optional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
