# Copy to .env and adjust. Read by `docker compose` for variable substitution.
POSTGRES_USER=autopoint
POSTGRES_PASSWORD=autopoint
POSTGRES_DB=autopoint
POSTGRES_PORT=5432

# API (when running outside Docker the defaults already point at the compose db)
# ENVIRONMENT=development            # development | test | production
# DATABASE_URL=postgresql+psycopg://autopoint:autopoint@localhost:5432/autopoint
# CORS_ORIGINS=["http://localhost:3000"]
# LOG_LEVEL=INFO

# Host port for the API container (change if 8000 is taken on your machine)
API_PORT=8000
# Public URL of the website (canonical links, sitemap, Open Graph)
SITE_URL=http://localhost:3000
